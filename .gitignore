# =============================================
# ChangeStory — .gitignore
# =============================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
*.pyo
*.pyd
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# ---- Node / Next.js ----
node_modules/
.next/
out/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js
.yarn/

# ---- Sensitive / Secrets (NEVER push these) ----
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.p12
*.pfx
secrets/
secret.*

# ---- Runtime / Session data ----
bob_sessions/
reports/
*.log
.changestory/

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- IDE / Editor ----
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ---- Build artifacts ----
dist/
build/
